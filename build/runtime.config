BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_VERSION_15_X=y
BR2_KERNEL_HEADERS_5_15=y
BR2_OPTIMIZE_2=y
BR2_STRIP_strip=y
# BR2_INIT_BUSYBOX is not set
BR2_INIT_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# No /bin/sh: Buildroot's default bash pulls in GPL-3.0 readline, which SQLite then links.
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_WPEWEBKIT=y
# BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA is not set
# BR2_PACKAGE_WPEWEBKIT_SANDBOX is not set
BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y
BR2_PACKAGE_GLIB_NETWORKING=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_WOFF2=y
