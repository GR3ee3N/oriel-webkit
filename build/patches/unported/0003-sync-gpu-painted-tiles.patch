+void BitmapTexture::waitForReuse()
+{
+    // Retain the fence because this wait orders only the current context.
+    // A borrower that aborts before drawing must preserve protection for later users.
+    Locker locker { m_reuseFenceLock };
+    if (m_reuseFence)
+        m_reuseFence->serverWait();
