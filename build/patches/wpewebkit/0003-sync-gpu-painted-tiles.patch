-CoordinatedPlatformLayerBufferRGB::~CoordinatedPlatformLayerBufferRGB() = default;
+CoordinatedPlatformLayerBufferRGB::~CoordinatedPlatformLayerBufferRGB()
+{
+    // Modified for Oriel on 2026-10-14: a painting target goes back to the pool fenced.
+    // Not drawn: its paint's fence still applies (a paint without one has finished).
+    // Drawn by the compositor, whose context is current here: fence that draw, or
+    // wait for it.
+    if (!m_texture || !m_texture->flags().contains(BitmapTexture::Flags::PaintingTarget))
+        return;
+    if (m_fence) {
+        m_texture->setReuseFence(WTF::move(m_fence));
+        return;
+    }
+    if (!GLContextWrapper::currentContext())
+        return;
+    auto& glDisplay = PlatformDisplay::sharedDisplay().glDisplay();
+    std::unique_ptr<GLFence> fence = GLFence::isSupported(glDisplay) ? GLFence::create(glDisplay) : nullptr;
+    if (fence)
+        m_texture->setReuseFence(WTF::move(fence));
+    else
+        glFinish();
+}
 
