+// Modified for Oriel on 2026-10-14.
+void BitmapTexture::setReuseFence(std::unique_ptr<GLFence>&& fence)
+{
+    Locker locker { m_reuseFenceLock };
+    m_reuseFence = WTF::move(fence);
 }
 
+void BitmapTexture::waitForReuse()
+{
+    // The fence stays: the wait only orders this context, and a borrower that fails
+    // before drawing must leave the texture as protected as it found it.
+    Locker locker { m_reuseFenceLock };
+    if (m_reuseFence)
+        m_reuseFence->serverWait();
+}
